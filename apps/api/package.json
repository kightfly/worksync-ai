{
  "name": "@ai-harness/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts --max-warnings 0",
    "db:migrate": "drizzle-kit push:pg --config=drizzle.config.cjs",
    "db:seed": "npm run db:seed -w @ai-harness/infrastructure"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "drizzle-orm": "^0.29.0",
    "fastify": "^4.25.0",
    "pg": "^8.11.0",
    "zod": "^3.22.0",
    "@ai-harness/infrastructure": "*",
    "dotenv": "^16.4.5",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "@ai-harness/domain": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.0",
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6"
  }
}
